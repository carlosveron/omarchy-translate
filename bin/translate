#!/usr/bin/env bash
# carlos.translate helper — translation with pluggable engines.
#
# Usage:
#   translate --to <lang> [--from <lang>] [--engine online|offline|google] <text...>
#   translate --to es --from auto "Hello world"
#   translate --to en --from pt --engine offline "gatinhando"
#   echo "Hello" | translate --to es
#
# Engines:
#   online  — free MyMemory API (no key). Needs network, has a daily quota.
#   offline — on-device Argos Translate models (no network after setup).
#             Needs the venv at ~/.local/share/carlos.translate/venv plus
#             language packages (see README). Missing es/pt/fr/de<->en pairs
#             are downloaded on demand (needs network once, ~100MB each).
#   google  — Google Translate. Free path first: the `googletrans` Python
#             library (works out of the box, no key, no system package).
#             Falls back to the `trans` CLI when installed
#             (omarchy pkg add translate-shell), then to the Cloud API when
#             GOOGLE_TRANSLATE_API_KEY is set.
#
# Output is always a single JSON object on stdout:
#   {"ok": true, "translated": "...", "source": "en", "target": "es", "engine": "online"}
#   {"ok": false, "error": "..."}
set -u

TO="en"
FROM="auto"
ENGINE="online"
TEXT=""

usage() {
  echo '{"ok": false, "error": "usage: translate --to <lang> [--from <lang>] [--engine online|offline] <text>"}'
  exit 0
}

while (($# > 0)); do
  case "${1:-}" in
    --to)
      TO="${2:-}"; shift 2 ;;
    --from)
      FROM="${2:-}"; shift 2 ;;
    --engine)
      ENGINE="${2:-}"; shift 2 ;;
    -h|--help)
      usage ;;
    --)
      shift; TEXT="$*"; break ;;
    -*)
      echo "{\"ok\": false, \"error\": \"unknown flag: $1\"}"
      exit 0 ;;
    *)
      TEXT="$*"; break ;;
  esac
done

# Allow piping: echo "hi" | translate --to es
if [[ -z "$TEXT" && ! -t 0 ]]; then
  TEXT="$(cat)"
fi

# Normalize: trim whitespace.
TEXT="$(printf '%s' "$TEXT" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
if [[ -z "$TEXT" ]]; then
  echo '{"ok": false, "error": "empty text"}'
  exit 0
fi
if [[ -z "$TO" ]]; then
  echo '{"ok": false, "error": "missing target language"}'
  exit 0
fi

# UI caps input at 500 chars; MyMemory anonymous requests cap q at ~500.
TEXT="${TEXT:0:480}"

export TRANSLATE_TEXT="$TEXT"
export TRANSLATE_FROM="$FROM"
export TRANSLATE_TO="$TO"

online_translate() {
  local from="$TRANSLATE_FROM"
  # MyMemory uses "autodetect" (not "auto") for source detection.
  if [[ "$from" == "auto" ]]; then
    from="autodetect"
  fi

  local response
  response="$(curl -s --max-time 20 --get \
    --data-urlencode "q=$TRANSLATE_TEXT" \
    --data-urlencode "langpair=$from|$TRANSLATE_TO" \
    "https://api.mymemory.translated.net/get" 2>/dev/null)"
  local curl_status=$?

  if (( curl_status != 0 )) || [[ -z "$response" ]]; then
    python3 -c 'import json; print(json.dumps({"ok": False, "error": "network error — check connection or try the offline engine"}))'
    exit 0
  fi

  export TRANSLATE_RESPONSE="$response"
  python3 <<'PY'
import json, os

raw = os.environ.get("TRANSLATE_RESPONSE", "")
try:
    data = json.loads(raw)
except Exception:
    print(json.dumps({"ok": False, "error": "bad response from translation service"}))
    raise SystemExit

# MyMemory error shapes: responseStatus != 200, quotaFinished, or 429/403 strings.
status = data.get("responseStatus")
translated = (data.get("responseData") or {}).get("translatedText", "")
# API sometimes returns "QUERY LENGTH LIMIT EXCEEDED" or "INVALID EMAIL" as text.
bad_markers = ["QUERY LENGTH LIMIT EXCEEDED", "INVALID TARGET LANGUAGE", "INVALID SOURCE LANGUAGE", "NO QUERY SPECIFIED"]
if isinstance(translated, str) and any(m in translated for m in bad_markers):
    print(json.dumps({"ok": False, "error": translated.strip().lower().capitalize()}))
    raise SystemExit

if status != 200 or not (translated or "").strip():
    detail = str(data.get("responseDetails", "") or "").strip()
    if data.get("quotaFinished"):
        detail = "daily free quota reached — try the offline engine"
    print(json.dumps({"ok": False, "error": detail or "translation failed"}))
    raise SystemExit

# Detect source lang: prefer top-level detectedLanguage (autodetect mode),
# fall back to first match source (best-effort).
source = ""
try:
    rd = data.get("responseData") or {}
    if isinstance(rd.get("detectedLanguage"), str):
        source = rd.get("detectedLanguage") or ""
    if not source:
        matches = data.get("matches") or []
        if matches and isinstance(matches[0], dict):
            source = str(matches[0].get("source", "") or "")
except Exception:
    source = ""

print(json.dumps({
    "ok": True,
    "translated": translated.strip(),
    "source": source,
    "target": os.environ.get("TRANSLATE_TO", ""),
    "engine": "online",
}))
PY
}

offline_translate() {
  # Prefer an Omarchy system install (e.g. AUR argos-translate) when it
  # provides both modules; fall back to the self-contained uv venv so the
  # widget works with zero system packages.
  local venv_py="$HOME/.local/share/carlos.translate/venv/bin/python"
  local offline_py=""
  if python3 -c "import argostranslate.translate, langdetect" 2>/dev/null; then
    offline_py="python3"
  elif [[ -x "$venv_py" ]] && "$venv_py" -c "import argostranslate.translate, langdetect" 2>/dev/null; then
    offline_py="$venv_py"
  else
    echo '{"ok": false, "error": "offline engine not installed — see README (uv venv + argostranslate)"}'
    exit 0
  fi
  # Stanza/argos log progress bars and warnings on stderr; the JSON contract
  # lives on stdout and real failures are reported as error JSON.
  "$offline_py" - 2>/dev/null <<'PY'
import json, os, sys

try:
    from argostranslate import package as packages
    from argostranslate import translate as translator
except Exception:
    print(json.dumps({"ok": False, "error": "offline engine broken — reinstall the venv (see README)"}))
    raise SystemExit

def norm(code):
    c = str(code or "").strip().lower().replace("_", "-")
    return {"zh-cn": "zh", "zh-tw": "zh"}.get(c, c.split("-")[0] if "-" in c and len(c) > 5 else c)

text = os.environ.get("TRANSLATE_TEXT", "")
frm = norm(os.environ.get("TRANSLATE_FROM", "auto"))
to = norm(os.environ.get("TRANSLATE_TO", "en"))

# Auto-detect source with langdetect (tiny, offline).
if frm in ("auto", "autodetect"):
    try:
        from langdetect import detect
        frm = norm(detect(text))
    except Exception:
        print(json.dumps({"ok": False, "error": "could not detect source language"}))
        raise SystemExit

if frm == to:
    print(json.dumps({"ok": True, "translated": text, "source": frm, "target": to, "engine": "offline"}))
    raise SystemExit

def find_translation(f, t):
    installed = translator.get_installed_languages()
    src = next((x for x in installed if x.code == f), None)
    dst = next((x for x in installed if x.code == t), None)
    if src is None or dst is None:
        return None
    try:
        return src.get_translation(dst)
    except Exception:
        return None

translation = find_translation(frm, to)

# Missing pair: download it on demand (needs network once, ~100MB).
if translation is None:
    try:
        packages.update_package_index()
        available = packages.get_available_packages()
        pkg = next((p for p in available if p.from_code == frm and p.to_code == to), None)
        if pkg is None:
            print(json.dumps({"ok": False, "error": "no offline model for %s to %s" % (frm, to)}))
            raise SystemExit
        pkg.install()
        translation = find_translation(frm, to)
    except SystemExit:
        raise
    except Exception as e:
        print(json.dumps({"ok": False, "error": "could not download offline model (%s) — connect and retry" % e}))
        raise SystemExit

if translation is None:
    print(json.dumps({"ok": False, "error": "offline model %s to %s unavailable" % (frm, to)}))
    raise SystemExit

try:
    out = translation.translate(text)
except Exception as e:
    print(json.dumps({"ok": False, "error": "offline translation failed (%s)" % e}))
    raise SystemExit

print(json.dumps({
    "ok": True,
    "translated": str(out).strip(),
    "source": frm,
    "target": to,
    "engine": "offline",
}))
PY
}

google_translate() {
  local from="$TRANSLATE_FROM"
  if [[ "$from" == "autodetect" ]]; then
    from="auto"
  fi

  # Path 1 (free): Google's public GTX endpoint, same recipe as the
  # local_reader app — translate.google.com (NOT translate.googleapis.com),
  # client=gtx, browser User-Agent, paced requests, retries with backoff.
  if google_gtx_direct "$from" "$TRANSLATE_TO" "$TRANSLATE_TEXT"; then
    exit 0
  fi

  # Path 2 (free): googletrans library — no key, no system package.
  local venv_py="$HOME/.local/share/carlos.translate/venv/bin/python"
  local gpy=""
  if [[ -x "$venv_py" ]] && "$venv_py" -c "import googletrans" 2>/dev/null; then
    gpy="$venv_py"
  elif python3 -c "import googletrans" 2>/dev/null; then
    gpy="python3"
  fi
  if [[ -n "$gpy" ]]; then
    export GOOGLE_FROM="$(printf '%s' "$from" | tr '[:upper:]' '[:lower:]')"
    export GOOGLE_TO="$(printf '%s' "$TRANSLATE_TO" | tr '[:upper:]' '[:lower:]')"
    if "$gpy" - 2>/dev/null <<'PY'
import asyncio, json, os, sys

async def main():
    from googletrans import Translator
    text = os.environ.get("TRANSLATE_TEXT", "")
    frm = os.environ.get("GOOGLE_FROM", "auto") or "auto"
    to = os.environ.get("GOOGLE_TO", "en") or "en"
    async with Translator() as t:
        r = await asyncio.wait_for(
            t.translate(text, src=frm, dest=to), timeout=25)
        out = str(r.text or "").strip()
        if not out:
            sys.exit(4)
        # Google's free endpoints soft-block by echoing the input. Never
        # present an echo as a translation — fall through to the next path.
        if frm != to and out.casefold() == text.strip().casefold():
            sys.exit(3)
        print(json.dumps({
            "ok": True,
            "translated": out,
            "source": str(getattr(r, "src", "") or ""),
            "target": to,
            "engine": "google"}))

asyncio.run(main())
PY
    then
      exit 0
    fi
    # googletrans failed, empty, or echoed (rate-limited?) — next path.
  fi

  # Path 2 (free): translate-shell CLI.
  if command -v trans >/dev/null 2>&1; then
    local args=(-b)
    if [[ -n "$from" && "$from" != "auto" ]]; then
      args+=(-s "$from")
    fi
    args+=(-t "$TRANSLATE_TO" "$TRANSLATE_TEXT")
    local out
    # TERM=dumb keeps trans from emitting color codes.
    out="$(TERM=dumb trans "${args[@]}" 2>/dev/null)"
    local status=$?
    out="$(printf '%s' "$out" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if (( status == 0 )) && [[ -n "$out" ]]; then
      export GOOGLE_OUT="$out" GOOGLE_FROM="$from"
      python3 -c 'import json, os; print(json.dumps({
        "ok": True,
        "translated": os.environ.get("GOOGLE_OUT", ""),
        "source": "" if os.environ.get("GOOGLE_FROM", "auto") == "auto" else os.environ.get("GOOGLE_FROM", ""),
        "target": os.environ.get("TRANSLATE_TO", ""),
        "engine": "google"}))'
      exit 0
    fi
    # trans failed (blocked/network) — fall through to the Cloud API.
  fi

  # Path 2: Google Cloud Translation API (needs billing-enabled key).
  if [[ -z "${GOOGLE_TRANSLATE_API_KEY:-}" ]]; then
    echo '{"ok": false, "error": "google engine needs translate-shell (omarchy pkg add translate-shell) or GOOGLE_TRANSLATE_API_KEY"}'
    exit 0
  fi

  local response
  if [[ -n "$from" && "$from" != "auto" ]]; then
    response="$(curl -s --max-time 20 -X POST \
      --data-urlencode "q=$TRANSLATE_TEXT" \
      --data-urlencode "target=$TRANSLATE_TO" \
      --data-urlencode "source=$from" \
      --data-urlencode "format=text" \
      --data-urlencode "key=$GOOGLE_TRANSLATE_API_KEY" \
      "https://translation.googleapis.com/language/translate/v2" 2>/dev/null)"
  else
    response="$(curl -s --max-time 20 -X POST \
      --data-urlencode "q=$TRANSLATE_TEXT" \
      --data-urlencode "target=$TRANSLATE_TO" \
      --data-urlencode "format=text" \
      --data-urlencode "key=$GOOGLE_TRANSLATE_API_KEY" \
      "https://translation.googleapis.com/language/translate/v2" 2>/dev/null)"
  fi
  local curl_status=$?

  if (( curl_status != 0 )) || [[ -z "$response" ]]; then
    python3 -c 'import json; print(json.dumps({"ok": False, "error": "network error — check connection"}))'
    exit 0
  fi

  export TRANSLATE_RESPONSE="$response"
  python3 <<'PY'
import html, json, os

try:
    data = json.loads(os.environ.get("TRANSLATE_RESPONSE", ""))
except Exception:
    print(json.dumps({"ok": False, "error": "bad response from google"}))
    raise SystemExit

err = (data.get("error") or {}).get("message", "")
if err:
    print(json.dumps({"ok": False, "error": "google: " + str(err)[:160]}))
    raise SystemExit

try:
    first = (data.get("data") or {}).get("translations", [])[0]
    translated = html.unescape(str(first.get("translatedText", "")))
    detected = str(first.get("detectedSourceLanguage", "") or "")
except Exception:
    print(json.dumps({"ok": False, "error": "bad response from google"}))
    raise SystemExit

if not translated.strip():
    print(json.dumps({"ok": False, "error": "google returned no translation"}))
    raise SystemExit

print(json.dumps({
    "ok": True,
    "translated": translated.strip(),
    "source": detected,
    "target": os.environ.get("TRANSLATE_TO", ""),
    "engine": "google",
}))
PY
}

# Direct GTX request, mirroring local_reader's TextTranslator: browser
# User-Agent, 200ms pacing between requests, up to 3 attempts with
# exponential backoff (1.5s, 3s), 15s timeout. Retries 429/5xx and network
# errors; the "Sorry" block page fails fast (retries won't clear it).
# Prints the result JSON and returns 0 on success, 1 otherwise.
google_gtx_direct() {
  local from="$1" to="$2" text="$3"
  local ua="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36"
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/carlos.translate"
  local gate="$state_dir/gtx_last_ms"
  mkdir -p "$state_dir" 2>/dev/null

  local attempt body code curl_status now last elapsed
  for attempt in 0 1 2; do
    # Pace: at least 200ms since the previous request.
    now=$(date +%s%3N)
    if [[ -f "$gate" ]]; then
      last=$(cat "$gate" 2>/dev/null || echo 0)
      elapsed=$((now - last))
      if (( elapsed < 200 )); then
        sleep "$(awk "BEGIN {print (200 - $elapsed)/1000}")"
        now=$(date +%s%3N)
      fi
    fi
    printf '%s' "$now" > "$gate" 2>/dev/null

    body="$(curl -s --max-time 15 --get \
      -A "$ua" \
      --data-urlencode "client=gtx" \
      --data-urlencode "sl=$from" \
      --data-urlencode "tl=$to" \
      --data-urlencode "dt=t" \
      --data-urlencode "q=$text" \
      -w '\n%{http_code}' \
      "https://translate.google.com/translate_a/single" 2>/dev/null)"
    curl_status=$?
    code="$(printf '%s' "$body" | tail -n 1)"
    body="$(printf '%s' "$body" | sed '$d')"

    if (( curl_status == 0 )) && [[ "$code" == "200" ]]; then
      # Block page comes back as 200 + HTML: fail fast, retries won't help.
      if [[ "$body" == *"<title>Sorry"* ]]; then
        return 1
      fi
      export GTX_BODY="$body" GTX_TO="$to"
      if python3 <<'PY'
import json, os, sys
try:
    data = json.loads(os.environ.get("GTX_BODY", ""))
except Exception:
    sys.exit(7)
segs = data[0] if isinstance(data, list) and len(data) > 0 and isinstance(data[0], list) else None
det = data[2] if isinstance(data, list) and len(data) > 2 and isinstance(data[2], str) else ""
out = "".join(s[0] for s in segs
              if isinstance(s, list) and len(s) > 0 and isinstance(s[0], str)).strip() \
      if segs is not None else ""
if not out:
    sys.exit(7)
print(json.dumps({"ok": True, "translated": out,
                  "source": det, "target": os.environ.get("GTX_TO", ""),
                  "engine": "google"}))
PY
      then
        return 0
      fi
      # Empty/unparseable 200 body is not transient — stop retrying.
      return 1
    fi

    # Retryable: curl errors, 429, 5xx. Other 4xx are permanent.
    if [[ "$code" == "429" ]] || [[ "$code" == 5* ]] || (( curl_status != 0 )); then
      if (( attempt < 2 )); then
        sleep "$(awk "BEGIN {print 1.5 * (2 ^ $attempt)}")"
        continue
      fi
    fi
    return 1
  done
  return 1
}

case "$ENGINE" in
  online) online_translate ;;
  offline) offline_translate ;;
  google) google_translate ;;
  *)
    echo '{"ok": false, "error": "unknown engine (use online|offline|google)"}'
    exit 0 ;;
esac
